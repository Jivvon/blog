{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "start": "next dev -p 3020",
    "dev": "cross-env INIT_CWD=$PWD next dev -p 3020",
    "build": "cross-env INIT_CWD=$PWD node scripts/build.mjs",
    "serve": "next start -p 3020",
    "analyze": "cross-env ANALYZE=true node scripts/build.mjs",
    "lint": "eslint app components layouts lib scripts tests contentlayer.config.ts middleware.ts next.config.js data/headerNavLinks.ts data/siteMetadata.js",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,md,html}\"",
    "build:public": "cross-env BLOG_PROFILE=public node scripts/build.mjs",
    "build:private": "cross-env BLOG_PROFILE=private node scripts/build.mjs",
    "build:pages": "cross-env BLOG_PROFILE=public EXPORT=1 UNOPTIMIZED=1 node scripts/build.mjs",
    "serve:private": "cross-env BLOG_PROFILE=private next start -p 3020",
    "test": "node --test tests/*.test.mjs",
    "archive:sync": "node scripts/archive-substack.mjs",
    "archive:backup": "node scripts/archive-backup.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:export": "node scripts/verify-export.mjs"
  },
  "dependencies": {
    "@headlessui/react": "2.2.0",
    "@next/bundle-analyzer": "15.5.27",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.0.5",
    "@tailwindcss/typography": "^0.5.15",
    "body-scroll-lock": "^4.0.0-beta.0",
    "cheerio": "1.2.0",
    "contentlayer2": "0.5.5",
    "esbuild": "0.25.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.0.1",
    "next": "15.5.27",
    "next-contentlayer2": "0.5.5",
    "next-themes": "^0.4.6",
    "oci-common": "2.142.1",
    "pliny": "0.4.1",
    "postcss": "^8.4.24",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.0",
    "rehype-katex": "^7.0.0",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "2.18.0",
    "tailwindcss": "^4.0.5",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "8.11.2",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "@svgr/webpack": "^8.0.1",
    "@types/mdx": "^2.0.12",
    "@types/react": "^19.0.8",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^15.12.0",
    "husky": "^9.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1",
  "volta": {
    "node": "24.19.0",
    "yarn": "4.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
